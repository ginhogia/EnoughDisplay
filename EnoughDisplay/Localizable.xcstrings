    "error.displayAsleep": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system refused the change (error 1014). A display may be asleep; wake all displays and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統拒絕變更（錯誤 1014），可能有顯示器正在睡眠。請喚醒所有顯示器後再試。"
          }
        }
      }
    },
